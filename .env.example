# SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/engine_monitor
DATABASE_URL=sqlite:///./engine_monitor.db

# Optional source of live telemetry. The endpoint must return either a JSON
# array of telemetry records or {"data": [...]}.
SOURCE_API_URL=https://telemetry.example.com/api/v1/engine
SOURCE_API_TOKEN=replace-me

# Location of the trained scikit-learn model.
MODEL_PATH=./artifacts/condition_model.joblib
